# Local MerchGrid source-pack configuration. Copy this file to .env and fill
# in real values locally. Do not commit .env or share credential values.

# PostHog: project settings identify the project; create a personal API key
# with only the read access required for aggregate queries.
POSTHOG_PROJECT_ID=
POSTHOG_PERSONAL_API_KEY=
POSTHOG_BASE_URL=https://us.posthog.com

# OpenAI: local key for the Buffr workflow agent runner. Do not commit it.
OPENAI_API_KEY=

# Fly: use the organization slug, app name, and a read-only metrics token.
FLY_ORG_SLUG=
FLY_ACCESS_TOKEN=
FLY_APP_NAME=

# Shopify Partner: export the approved aggregate CSV and point to its artifact path.
SHOPIFY_PARTNER_AGGREGATES_CSV_PATH=artifacts/merchgrid/sources/shopify-partner-aggregates.csv

# Buffr-owned evidence output. These JSON snapshots and review artifacts are safe
# aggregate artifacts intended to be committed when reviewed.
MERCHGRID_METRICS_DATA_DIR=artifacts/merchgrid/metrics

# Marketplace visibility review: curated product context used for sparse-data recommendations.
MERCHGRID_VISIBILITY_CONTEXT_PATH=artifacts/merchgrid/context/merchgrid-visibility-context.json
MERCHGRID_LISTING_CONTEXT_PATH=artifacts/merchgrid/context/merchgrid-listing-context.json
